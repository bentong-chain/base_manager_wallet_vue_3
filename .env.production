# ============================================
# 🌐 网络配置
# ============================================
# 代理前缀
VITE_APP_BASE_API = '/prod-api'
# 项目名称
VITE_APP_TITLE=后台管理系统
# WebSocket 端点（可选）
#VITE_APP_WS_ENDPOINT=wss://api.youlai.tech/ws

# ============================================
# 🎛️ 功能开关
# ============================================
# 多租户（需与后端 app.tenant.enabled 保持一致）
VITE_APP_TENANT_ENABLED=true

# 认证方案：true=签名+双 Token(common-system)，false 或不设=Bearer
# VITE_USE_SIGN_AUTH=false
# 签名模式下刷新 Token 路径（与 VITE_APP_BASE_API 拼接）
# VITE_APP_AUTH_REFRESH_PATH=/api/v1/auth/refresh-token
