# API 调用规范

## 请求链路概览

**标准请求流程**：
```
页面 View 
  → 页面逻辑 Composables / 页面内逻辑 
    → API 模块 (modules/*.ts)
      → 请求封装层 (client.ts)
        → 认证签名 (auth.ts)
          → 后端接口
            → 响应处理
              → 页面更新
```

**职责划分**：
- **View 层**：展示数据、触发用户交互
- **Composables 层**：封装可复用的业务逻辑和状态管理
- **API 模块层**：定义具体的 API 调用函数
- **请求封装层**：统一处理请求/响应、拦截器、错误处理
- **认证签名层**：处理请求签名和加密

## 目录结构

```
api/
├── modules/          # API 模块（按业务划分）
│   ├── user.ts       # 用户相关 API
│   ├── product.ts    # 产品相关 API
│   └── order.ts      # 订单相关 API
├── client.ts         # HTTP 客户端封装
├── auth.ts           # 认证签名逻辑
├── types.ts          # 类型定义
└── constants.ts      # 常量配置
```

## 第一层：请求封装层 (client.ts)

### 统一的 HTTP 客户端
**规则**：所有 API 调用必须通过封装的客户端

```typescript
// api/client.ts
import axios from 'axios'
import { useAuthStore } from '@/stores/modules/auth'
import { buildAuthHeaderValues } from './auth'
import { encryptWithPublicKey } from '@/utils/rsa'
import type { ApiResult } from './types'

// 创建 axios 实例
const instance = axios.create({
  baseURL: import.meta.env.VITE_API_BASE_URL,
  timeout: 10000
})

// 请求拦截器
instance.interceptors.request.use(
  (config) => {
    // 可以在这里添加全局请求处理
    return config
  },
  (error) => {
    return Promise.reject(error)
  }
)

// 响应拦截器
instance.interceptors.response.use(
  (response) => {
    const result: ApiResult = response.data
    
    // 统一处理业务错误码
    if (result.code !== 200) {
      ElMessage.error(result.message || '请求失败')
      return Promise.reject(new Error(result.message))
    }
    
    return response
  },
  (error) => {
    // 统一处理 HTTP 错误
    if (error.response) {
      const { status } = error.response
      switch (status) {
        case 401:
          ElMessage.error('登录已过期，请重新登录')
          router.push('/login')
          break
        case 403:
          ElMessage.error('没有权限访问')
          break
        case 404:
          ElMessage.error('请求的资源不存在')
          break
        case 500:
          ElMessage.error('服务器错误，请稍后重试')
          break
        default:
          ElMessage.error('请求失败')
      }
    } else if (error.request) {
      ElMessage.error('网络连接失败，请检查网络')
    }
    
    return Promise.reject(error)
  }
)

/**
 * GET 请求
 * @param url - 请求路径
 * @param params - 查询参数
 * @returns 响应数据
 */
export async function get<T>(
  url: string, 
  params?: Record<string, unknown>
): Promise<T> {
  const authStore = useAuthStore()
  
  // 构建认证请求头
  const headers = await buildAuthHeaderValues(
    {
      token: authStore.accessToken,
      salt: authStore.currentSalt,
      device: authStore.deviceId,
      businessParams: params || {}
    },
    (plain) => encryptWithPublicKey(plain, authStore.currentPublicKey)
  )
  
  const response = await instance.get<ApiResult<T>>(url, { params, headers })
  return response.data.data as T
}

/**
 * POST 请求
 * @param url - 请求路径
 * @param data - 请求体数据
 * @returns 响应数据
 */
export async function post<T>(
  url: string, 
  data?: Record<string, unknown>
): Promise<T> {
  const authStore = useAuthStore()
  
  const headers = await buildAuthHeaderValues(
    {
      token: authStore.accessToken,
      salt: authStore.currentSalt,
      device: authStore.deviceId,
      businessParams: data || {}
    },
    (plain) => encryptWithPublicKey(plain, authStore.currentPublicKey)
  )
  
  const response = await instance.post<ApiResult<T>>(url, data, { headers })
  return response.data.data as T
}

/**
 * PUT 请求
 */
export async function put<T>(
  url: string, 
  data?: Record<string, unknown>
): Promise<T> {
  const authStore = useAuthStore()
  
  const headers = await buildAuthHeaderValues(
    {
      token: authStore.accessToken,
      salt: authStore.currentSalt,
      device: authStore.deviceId,
      businessParams: data || {}
    },
    (plain) => encryptWithPublicKey(plain, authStore.currentPublicKey)
  )
  
  const response = await instance.put<ApiResult<T>>(url, data, { headers })
  return response.data.data as T
}

/**
 * DELETE 请求
 */
export async function del<T>(
  url: string, 
  params?: Record<string, unknown>
): Promise<T> {
  const authStore = useAuthStore()
  
  const headers = await buildAuthHeaderValues(
    {
      token: authStore.accessToken,
      salt: authStore.currentSalt,
      device: authStore.deviceId,
      businessParams: params || {}
    },
    (plain) => encryptWithPublicKey(plain, authStore.currentPublicKey)
  )
  
  const response = await instance.delete<ApiResult<T>>(url, { params, headers })
  return response.data.data as T
}
```

## 第二层：API 模块层 (modules/*.ts)

### API 模块定义
**规则**：按业务模块组织 API 函数

```typescript
// api/modules/user.ts
import { get, post, put, del } from '../client'
import type { User, UserListParams, UserListResult } from '../types'

/**
 * 获取用户列表
 */
export function getUserList(params: UserListParams) {
  return get<UserListResult>('/users', params)
}

/**
 * 获取用户详情
 */
export function getUserDetail(id: number) {
  return get<User>(`/users/${id}`)
}

/**
 * 创建用户
 */
export function createUser(data: Partial<User>) {
  return post<User>('/users', data)
}

/**
 * 更新用户
 */
export function updateUser(id: number, data: Partial<User>) {
  return put<User>(`/users/${id}`, data)
}

/**
 * 删除用户
 */
export function deleteUser(id: number) {
  return del<void>(`/users/${id}`)
}
```

```typescript
// api/modules/auth.ts
import { post } from '../client'
import type { LoginRequest, LoginResponse, RegisterRequest } from '../types'

/**
 * 用户登录
 */
export function login(data: LoginRequest) {
  return post<LoginResponse>('/member/login', data)
}

/**
 * 用户注册
 */
export function register(data: RegisterRequest) {
  return post<void>('/member/register', data)
}

/**
 * 用户登出
 */
export function logout() {
  return post<void>('/member/logout')
}

/**
 * 刷新 Token
 */
export function refreshToken() {
  return post<LoginResponse>('/member/refresh-token')
}
```

