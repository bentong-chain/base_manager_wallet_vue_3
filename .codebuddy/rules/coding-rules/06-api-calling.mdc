### 5. 请求重试
```typescript
// utils/retry.ts
export async function retryRequest<T>(
  fetcher: () => Promise<T>,
  maxRetries = 3,
  delay = 1000
): Promise<T> {
  let lastError: Error

  for (let i = 0; i < maxRetries; i++) {
    try {
      return await fetcher()
    } catch (error) {
      lastError = error instanceof Error ? error : new Error('请求失败')
      
      // 最后一次重试失败则抛出错误
      if (i === maxRetries - 1) {
        throw lastError
      }

      // 等待后重试
      await new Promise(resolve => setTimeout(resolve, delay * (i + 1)))
    }
  }

  throw lastError!
}

// 使用
async function fetchUserWithRetry(id: number) {
  return await retryRequest(() => getUserDetail(id), 3, 1000)
}
```

## 认证与签名

### 请求签名流程
```typescript
// api/auth.ts

/**
 * 生成随机 nonce
 */
export function generateNonceSrc(): string {
  const arr = new Uint8Array(16)
  crypto.getRandomValues(arr)
  return Array.from(arr, (b) => b.toString(16).padStart(2, '0')).join('')
}

/**
 * 构建签名
 */
export function buildSign(
  paramString: string,
  nonceSrc: string,
  salt: string
): string {
  return sha256(paramString + nonceSrc + salt)
}

/**
 * 构建参数字符串
 */
export function buildParamString(params: Record<string, any>): string {
  return Object.keys(params)
    .sort()
    .map(key => `${key}=${params[key]}`)
    .join('&')
}

/**
 * 构建认证请求头
 */
export async function buildAuthHeaderValues(
  input: AuthHeadersInput,
  encryptNonce: (plain: string) => Promise<string>
): Promise<AuthHeadersResult> {
  const timestamp = String(Date.now())
  const nonceSrc = generateNonceSrc()
  
  // 构建签名参数
  const signParams = {
    token: input.token,
    timestamp,
    device: input.device,
    ...input.businessParams
  }
  
  const paramString = buildParamString(signParams)
  const sign = buildSign(paramString, nonceSrc, input.salt)
  
  // 加密 nonce
  const nonceEncrypted = await encryptNonce(nonceSrc)
  
  return {
    'X-Auth-Token': input.token,
    'X-Auth-Timestamp': timestamp,
    'X-Auth-Sign': sign,
    'X-Auth-Nonce': nonceEncrypted,
    'X-Auth-Device': input.device,
  }
}

/**
 * 认证请求头输入
 */
export interface AuthHeadersInput {
  token: string
  salt: string
  device: string
  businessParams: Record<string, any>
}

/**
 * 认证请求头结果
 */
export interface AuthHeadersResult {
  'X-Auth-Token': string
  'X-Auth-Timestamp': string
  'X-Auth-Sign': string
  'X-Auth-Nonce': string
  'X-Auth-Device': string
}
```

## 最佳实践总结

### 1. 分层清晰
```
✅ 正确的调用链路
View → Composables → API Module → Client → Backend

❌ 错误的调用方式
View → Client 直接调用（跳过 API Module）
View → Backend 直接调用（跳过所有封装）
```

### 2. 使用 TypeScript
```typescript
✅ 正确 - 完整的类型定义
async function fetchUser(id: number): Promise<User> {
  return await getUserDetail(id)
}

❌ 错误 - 缺少类型
async function fetchUser(id) {
  return await getUserDetail(id)
}
```

### 3. 统一错误处理
```typescript
✅ 正确 - 三层错误处理
// 1. Client 层：HTTP 错误
// 2. API Module 层：业务错误
// 3. Composables/View 层：页面错误

❌ 错误 - 没有错误处理
const data = await getUserDetail(id)  // 可能抛出异常
```

### 4. 管理加载状态
```typescript
✅ 正确 - 使用 finally
async function fetchData() {
  loading.value = true
  try {
    await getUserList(params)
  } finally {
    loading.value = false  // 确保重置
  }
}

❌ 错误 - 可能不会重置
async function fetchData() {
  loading.value = true
  await getUserList(params)
  loading.value = false  // 出错时不会执行
}
```

### 5. 参数验证
```typescript
✅ 正确 - 验证参数
async function fetchUser(id: number) {
  if (!id || id <= 0) {
    throw new Error('无效的用户 ID')
  }
  return await getUserDetail(id)
}

❌ 错误 - 不验证参数
async function fetchUser(id: number) {
  return await getUserDetail(id)  // 可能传入无效值
}
```

### 6. 使用 Composables 封装
```typescript
✅ 正确 - 封装到 Composables
// composables/useUserList.ts
export function useUserList() {
  // 状态管理 + API 调用
  return { loading, users, fetchUsers }
}

❌ 错误 - 在组件中直接调用
// 每个组件都重复相同的逻辑
const loading = ref(false)
async function fetchUsers() { ... }
```

## 完整示例

### 示例：用户管理功能

#### 1. 类型定义
```typescript
// api/types.ts
export interface User {
  uid: number
  username: string
  name?: string
  email?: string
  status: 'active' | 'inactive'
}

export interface UserListParams {
  page: number
  pageSize: number
  keyword?: string
}

export interface UserListResult {
  list: User[]
  total: number
}
```

#### 2. API 模块
```typescript
// api/modules/user.ts
import { get, post, put, del } from '../client'
import type { User, UserListParams, UserListResult } from '../types'

export function getUserList(params: UserListParams) {
  return get<UserListResult>('/users', params)
}

export function getUserDetail(id: number) {
  return get<User>(`/users/${id}`)
}

export function createUser(data: Partial<User>) {
  return post<User>('/users', data)
}

export function updateUser(id: number, data: Partial<User>) {
  return put<User>(`/users/${id}`, data)
}

export function deleteUser(id: number) {
  return del<void>(`/users/${id}`)
}
```

#### 3. Composable
```typescript
// composables/useUserList.ts
import { ref } from 'vue'
import { getUserList, deleteUser } from '@/api/modules/user'
import type { User, UserListParams } from '@/api/types'

export function useUserList() {
  const loading = ref(false)
  const users = ref<User[]>([])
  const total = ref(0)

  async function fetchUsers(params: UserListParams) {
    loading.value = true
    try {
      const result = await getUserList(params)
      users.value = result.list
      total.value = result.total
    } finally {
      loading.value = false
    }
  }

  async function removeUser(id: number) {
    await deleteUser(id)
    users.value = users.value.filter(u => u.uid !== id)
    total.value--
  }

  return { loading, users, total, fetchUsers, removeUser }
}
```

#### 4. View 组件
```vue
<!-- views/UserList.vue -->
<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { useUserList } from '@/composables/useUserList'

const { loading, users, total, fetchUsers, removeUser } = useUserList()

const queryParams = ref({
  page: 1,
  pageSize: 20,
  keyword: ''
})

onMounted(() => {
  loadData()
})

function loadData() {
  fetchUsers(queryParams.value)
}

async function handleDelete(id: number) {
  await ElMessageBox.confirm('确定要删除吗？')
  await removeUser(id)
  ElMessage.success('删除成功')
}
</script>

<template>
  <div class="user-list">
    <el-table v-loading="loading" :data="users">
      <el-table-column prop="username" label="用户名" />
      <el-table-column label="操作">
        <template #default="{ row }">
          <el-button @click="handleDelete(row.uid)">删除</el-button>
        </template>
      </el-table-column>
    </el-table>
  </div>
</template>
```

## 总结

**请求链路**：
```
View → Composables → API Module → Client → Auth → Backend
```

**核心原则**：
- 分层清晰，职责明确
- 统一封装，避免重复
- 类型安全，完整定义
- 错误处理，三层防护
- 状态管理，响应式更新
- 性能优化，合理缓存
