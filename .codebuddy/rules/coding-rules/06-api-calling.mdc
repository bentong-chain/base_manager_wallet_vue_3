## 在 Store 中调用 API（全局状态）

### 适用场景
- 需要跨组件共享的状态
- 需要持久化的数据
- 全局配置信息

```typescript
// stores/modules/auth.ts
import { defineStore } from 'pinia'
import { ref, computed } from 'vue'
import { login, logout } from '@/api/modules/auth'
import type { LoginRequest, LoginResponse } from '@/api/types'

export const useAuthStore = defineStore('auth', () => {
  // State
  const accessToken = ref('')
  const currentPublicKey = ref('')
  const currentSalt = ref('')
  const deviceId = ref('')

  // Getters
  const isLoggedIn = computed(() => !!accessToken.value)

  // Actions
  async function loginAction(credentials: LoginRequest) {
    try {
      const response = await login(credentials)
      
      // 保存认证信息
      accessToken.value = response.accessToken
      currentPublicKey.value = response.publicKey
      currentSalt.value = response.salt
      
      ElMessage.success('登录成功')
      return response
    } catch (error) {
      ElMessage.error('登录失败')
      throw error
    }
  }

  async function logoutAction() {
    try {
      await logout()
    } finally {
      // 清除认证信息
      accessToken.value = ''
      currentPublicKey.value = ''
      currentSalt.value = ''
    }
  }

  return {
    accessToken,
    currentPublicKey,
    currentSalt,
    deviceId,
    isLoggedIn,
    loginAction,
    logoutAction
  }
})
```

## 错误处理策略

### 三层错误处理

#### 1. 请求封装层（client.ts）- 全局错误
处理 HTTP 状态码错误和网络错误

```typescript
// api/client.ts
instance.interceptors.response.use(
  (response) => {
    const result: ApiResult = response.data
    
    // 统一处理业务错误码
    if (result.code !== 200) {
      ElMessage.error(result.message || '请求失败')
      return Promise.reject(new Error(result.message))
    }
    
    return response
  },
  (error) => {
    // HTTP 错误处理
    if (error.response) {
      const { status } = error.response
      switch (status) {
        case 401:
          ElMessage.error('登录已过期，请重新登录')
          router.push('/login')
          break
        case 403:
          ElMessage.error('没有权限访问')
          break
        case 404:
          ElMessage.error('请求的资源不存在')
          break
        case 500:
          ElMessage.error('服务器错误，请稍后重试')
          break
      }
    } else if (error.request) {
      ElMessage.error('网络连接失败，请检查网络')
    }
    
    return Promise.reject(error)
  }
)
```

#### 2. API 模块层 - 特定业务错误
处理特定接口的业务逻辑错误

```typescript
// api/modules/auth.ts
export async function login(data: LoginRequest) {
  try {
    return await post<LoginResponse>('/member/login', data)
  } catch (error: any) {
    // 处理特定业务错误
    const subCode = error.response?.data?.subCode
    
    if (subCode === 'INVALID_CREDENTIALS') {
      ElMessage.error('用户名或密码错误')
    } else if (subCode === 'ACCOUNT_LOCKED') {
      ElMessage.error('账号已被锁定，请联系管理员')
    } else if (subCode === 'ACCOUNT_DISABLED') {
      ElMessage.error('账号已被禁用')
    }
    
    throw error
  }
}
```

#### 3. Composables/View 层 - 页面级错误
处理页面特定的错误逻辑

```typescript
// composables/useUserList.ts
export function useUserList() {
  const error = ref<string | null>(null)

  async function fetchUsers(params: UserListParams) {
    loading.value = true
    error.value = null

    try {
      const result = await getUserList(params)
      users.value = result.list
      total.value = result.total
    } catch (err) {
      // 页面级错误处理
      error.value = err instanceof Error ? err.message : '获取用户列表失败'
      
      // 可以在这里添加特定的错误处理逻辑
      if (err.response?.status === 403) {
        // 跳转到无权限页面
        router.push('/403')
      }
      
      throw err
    } finally {
      loading.value = false
    }
  }

  return { error, fetchUsers }
}
```

## 请求优化

### 1. 防抖和节流
```typescript
import { debounce, throttle } from 'lodash-es'

// 防抖：搜索输入（用户停止输入后才发送请求）
const searchUsers = debounce(async (keyword: string) => {
  const users = await getUserList({ page: 1, pageSize: 20, keyword })
  userList.value = users.list
}, 300)

// 节流：滚动加载（限制请求频率）
const loadMore = throttle(async () => {
  if (loading.value || !hasMore.value) return
  
  page.value++
  const result = await getUserList({ page: page.value, pageSize: 20 })
  userList.value.push(...result.list)
}, 500)
```

### 2. 请求取消
```typescript
// composables/useRequest.ts
import { ref, onUnmounted } from 'vue'

export function useRequest<T>(fetcher: () => Promise<T>) {
  const loading = ref(false)
  const data = ref<T | null>(null)
  const error = ref<Error | null>(null)
  const controller = new AbortController()

  async function execute() {
    loading.value = true
    error.value = null

    try {
      data.value = await fetcher()
    } catch (err) {
      if (err.name !== 'AbortError') {
        error.value = err instanceof Error ? err : new Error('请求失败')
      }
    } finally {
      loading.value = false
    }
  }

  function cancel() {
    controller.abort()
  }

  // 组件卸载时自动取消请求
  onUnmounted(() => {
    cancel()
  })

  return { loading, data, error, execute, cancel }
}
```

### 3. 请求缓存
```typescript
// utils/cache.ts
class RequestCache {
  private cache = new Map<string, { data: any; timestamp: number }>()
  private ttl = 5 * 60 * 1000 // 5分钟

  get<T>(key: string): T | null {
    const cached = this.cache.get(key)
    if (!cached) return null

    // 检查是否过期
    if (Date.now() - cached.timestamp > this.ttl) {
      this.cache.delete(key)
      return null
    }

    return cached.data
  }

  set(key: string, data: any) {
    this.cache.set(key, {
      data,
      timestamp: Date.now()
    })
  }

  clear() {
    this.cache.clear()
  }
}

export const requestCache = new RequestCache()

// 使用缓存
export async function getUserListWithCache(params: UserListParams) {
  const cacheKey = `user-list-${JSON.stringify(params)}`
  
  // 尝试从缓存获取
  const cached = requestCache.get<UserListResult>(cacheKey)
  if (cached) {
    return cached
  }

  // 请求数据
  const result = await getUserList(params)
  
  // 存入缓存
  requestCache.set(cacheKey, result)
  
  return result
}
```

