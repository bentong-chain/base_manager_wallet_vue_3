# 应用端口
VITE_APP_PORT=3000
# 项目名称
VITE_APP_TITLE=亿优社区后台管理系统
# 代理前缀
VITE_APP_BASE_API=/dev-api

# 接口地址
# VITE_APP_API_URL=https://api.youlai.tech         # 线上
# VITE_APP_API_URL=https://api.youlai.tech/v2    # 线上(多租户)
# VITE_APP_API_URL=http://localhost:8000         # 本地
# 本地开发时代理目标，最终请求：http://localhost:8099/api/admin/auth/captcha 等
VITE_APP_API_URL=http://192.168.1.28:8099

# WebSocket 端点（不配置则关闭）
# 线上: ws://api.youlai.tech/ws
# 本地: ws://localhost:8000/ws
VITE_APP_WS_ENDPOINT=


# 启用 Mock 服务(true:开启 false:关闭)
VITE_MOCK_DEV_SERVER=false


# 多租户开关(true:开启 false:关闭)
VITE_APP_TENANT_ENABLED=false

# 认证方案：是否启用签名 + 双 Token（common-system）
# true=签名模式(X-Auth-* Header + Cookie 刷新)；未设置或 false=Bearer 模式(Authorization: Bearer)
# 与 base_web_vue_3 一致：登录及所有请求均携带 X-Auth-Token / X-Auth-Sign / X-Auth-Nonce 等头
VITE_USE_SIGN_AUTH=true
# 签名模式下刷新 Token 的路径（与 VITE_APP_BASE_API 拼接），仅 VITE_USE_SIGN_AUTH=true 时生效
# VITE_APP_AUTH_REFRESH_PATH=/api/v1/auth/refresh-token
VITE_APP_AUTH_REFRESH_PATH=/api/v1/admin/auth/token/refresh

## sign info
VITE_APP_SIGN_INFO_NAME=TJT Admin

VITE_APP_SIGN_INFO_URL=http://192.168.1.54:3000

# 区块链网络配置(testnet:测试网 mainnet:主网)
VITE_BLOCKCHAIN_NETWORK=testnet
